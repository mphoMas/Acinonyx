# Environment and secrets
.env
.env.*
*.token

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Runtime outputs & audit logs
workspace/audit/
workspace/scratch/
workspace/*.png
workspace/*.jsonl
company/founder/*.log
workspace/data/*.log
workspace/data/*.db
# Preserve the database snapshot already versioned before the folder migration.
!workspace/data/comms_vault.db
workspace/data/*.db-*

# Node dependencies
node_modules/

# Vendored Google Cloud SDK (accidental local install dir)
gcloud auth application-default login/

# Local tooling
.venv/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
build/
*.egg-info/

# Vendored local binaries
bin/
